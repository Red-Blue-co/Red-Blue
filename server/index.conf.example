### Copy to index.conf (git-ignored) and fill in. sv-nex reads the block named by NE_ENV.
{
  "Production": {
    "APPLICATION_PORT_NUMBER": 3010,
    "DB_TYPE": "mysql",
    "MYSQLDB_HOST": "localhost",
    "MYSQLDB_PORT": 3306,
    "MYSQLDB_USER": "redblue",
    "MYSQLDB_PASSWORD": "change-me",
    "MYSQLDB_NAME": "redblue",
    "DIST_FOLDER_NAME": "build",
    ### Optional: OTP emails. Leave SMTP_HOST empty to skip sending (demo mode).
    ### Zoho (EU, own domain): host smtppro.zoho.eu, port 587; user = the mailbox address;
    ### password = a Zoho app-specific password. SMTP_FROM must be that mailbox or one of its aliases.
    "SMTP_HOST": "",
    "SMTP_PORT": 587,
    "SMTP_USER": "",
    "SMTP_PASSWORD": "",
    "SMTP_FROM": "",
    "SMTP_SENDER_NAME": "Red-Blue"
  }
}
